---
import BaseLayout from "~/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="py-16 md:py-20">
    <div class="container-page">
      <div class="max-w-3xl">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm text-ink-400 hover:text-vine-900 transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back home
        </a>
        <h1 class="mt-6 text-4xl md:text-5xl font-semibold tracking-tight">
          {title}
        </h1>
        <p class="mt-3 text-sm text-ink-400">
          Last updated: {lastUpdated}
        </p>

        <article class="prose-legal mt-10">
          <slot />
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
