---
const links = [
  { href: "/#products", label: "Projects" },
  { href: "/support", label: "Help" },
  { href: "https://github.com/vinelabs-de", label: "GitHub", external: true },
];
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-white/75 border-b border-ink-100/70">
  <div class="container-page flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2.5 group" aria-label="VineLab home">
      <img
        src="/brand/mark.svg"
        alt=""
        width="28"
        height="28"
        class="h-7 w-7 transition-transform group-hover:rotate-[-4deg]"
        onerror="this.style.display='none'"
      />
      <span class="font-semibold text-[1.05rem] tracking-tight">
        <span class="text-vine-900">Vine</span><span class="text-leaf-500">Lab</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-7" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink-600 hover:text-vine-900 transition-colors"
            {...link.external ? { target: "_blank", rel: "noopener noreferrer" } : {}}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/vinelabs-de"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost-light text-sm py-2 px-3.5"
      >
        <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
        Star on GitHub
      </a>
    </div>
  </div>
</header>
