---
import { getCollection } from "astro:content";
import { CATEGORIES, type CategorySlug } from "~/lib/categories";

const projects = (await getCollection("projects")).filter(
  (project) => !project.data.draft,
);

const counts = new Map<CategorySlug, number>();
for (const category of CATEGORIES) counts.set(category.slug, 0);
for (const project of projects) {
  for (const slug of project.data.categories) {
    counts.set(slug, (counts.get(slug) ?? 0) + 1);
  }
}
---

<section aria-label="What comes out of the lab" class="border-y border-ink-100 bg-white">
  <div class="container-page py-10">
    <div class="flex items-baseline justify-between gap-4 mb-6">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-400">
        What comes out of the lab
      </h2>
      <span class="text-xs text-ink-400 hidden sm:inline">
        Some shipped. Some growing. Some in the soil.
      </span>
    </div>

    <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      {
        CATEGORIES.map((category) => {
          const count = counts.get(category.slug) ?? 0;
          const hasProjects = count > 0;
          return (
            <li>
              <a
                href={`#cat=${category.slug}`}
                data-category-link={category.slug}
                class:list={[
                  "group relative h-full rounded-xl border bg-white p-4 flex flex-col transition cursor-pointer hover:-translate-y-0.5",
                  hasProjects
                    ? "border-ink-100 hover:border-vine-200 hover:shadow-card"
                    : "border-ink-100/70 opacity-80 hover:opacity-100 hover:border-ink-200",
                ]}
              >
                <div class="flex items-start justify-between gap-2">
                  <div class="flex items-center justify-center h-9 w-9 rounded-lg bg-vine-50 text-vine-700 group-hover:bg-vine-100 transition">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={category.icon} />
                    </svg>
                  </div>
                  <span
                    class:list={[
                      "text-[11px] font-mono font-semibold rounded-full px-2 py-0.5 tabular-nums",
                      hasProjects
                        ? "bg-vine-50 text-vine-800 border border-vine-100"
                        : "bg-ink-50 text-ink-400 border border-ink-100",
                    ]}
                  >
                    {hasProjects ? count : "soon"}
                  </span>
                </div>
                <p class="mt-3 text-sm font-semibold text-ink-900 leading-tight">
                  {category.name}
                </p>
                <p class="mt-1 text-xs text-ink-600 leading-snug">
                  {category.blurb}
                </p>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
