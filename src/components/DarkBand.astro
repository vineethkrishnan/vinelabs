---
const principles = [
  {
    title: "Self-host first",
    body: "Single binary, single image, single compose file. Deploy where it makes sense for you.",
  },
  {
    title: "Source you can audit",
    body: "Permissive or copyleft, never source-available. The threat model lives in the repo, not the marketing page.",
  },
  {
    title: "Supply chain hardened",
    body: "Signed releases, SBOMs, SLSA L3 provenance where it applies. You should be able to verify what you run.",
  },
  {
    title: "No telemetry tax",
    body: "Nothing phones home. If a project ever needs usage data, it is opt-in and the README spells out what is collected.",
  },
];
---

<section class="relative bg-ink-950 text-white overflow-hidden">
  <div class="absolute inset-0 grain opacity-30 pointer-events-none"></div>
  <div
    class="absolute -top-32 right-1/4 h-96 w-96 rounded-full bg-leaf-500/15 blur-3xl pointer-events-none"
  >
  </div>

  <div class="container-page py-20 md:py-28 relative">
    <div class="max-w-2xl">
      <span class="chip-dark chip">
        <span class="h-1.5 w-1.5 rounded-full bg-leaf-400"></span>
        How I build
      </span>
      <h2 class="mt-4 text-3xl md:text-4xl font-semibold tracking-tight text-balance">
        The lab runs on four ground rules.
      </h2>
      <p class="mt-3 text-white/70 text-lg leading-relaxed text-pretty">
        These are not slogans. They show up in every README, every release, and every line of code.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-10">
      {
        principles.map((principle, index) => (
          <div class="flex gap-5">
            <div class="flex-shrink-0 h-10 w-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center font-mono text-leaf-400 text-sm">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white">{principle.title}</h3>
              <p class="mt-1.5 text-sm text-white/70 leading-relaxed">
                {principle.body}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
