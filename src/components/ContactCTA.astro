---
---

<section id="contact" class="py-20 md:py-28 scroll-mt-24">
  <div class="container-page">
    <div class="relative rounded-3xl overflow-hidden border border-vine-100 bg-white shadow-card">
      <div
        class="absolute -top-24 -right-12 h-72 w-72 rounded-full bg-leaf-500/20 blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-24 -left-12 h-72 w-72 rounded-full bg-vine-700/15 blur-3xl pointer-events-none"
      >
      </div>

      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 p-8 md:p-14">
        <div>
          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-balance">
            Spotted a bug? Have a question? Want to say hi?
          </h2>
          <p class="mt-4 text-ink-600 text-lg leading-relaxed text-pretty">
            The fastest way to talk about the projects is on GitHub - issues for bugs, discussions for questions. For everything else, email works too.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="https://github.com/vinelabs-de"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
              Open an issue
            </a>
            <a href="mailto:info@vinelab.in" class="btn btn-ghost-light">
              info@vinelab.in
            </a>
          </div>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 self-center">
          <div class="rounded-xl bg-vine-50/60 border border-vine-100 p-5">
            <dt class="text-xs font-semibold uppercase tracking-wider text-vine-700">
              General + feedback
            </dt>
            <dd class="mt-2 text-ink-900 font-medium">info@vinelab.in</dd>
            <dd class="mt-1 text-xs text-ink-400">Read by a real person, not a queue</dd>
          </div>
          <div class="rounded-xl bg-vine-50/60 border border-vine-100 p-5">
            <dt class="text-xs font-semibold uppercase tracking-wider text-vine-700">
              Project help
            </dt>
            <dd class="mt-2 text-ink-900 font-medium">support@vinelab.in</dd>
            <dd class="mt-1 text-xs text-ink-400">See <a href="/support" class="underline">help guidelines</a></dd>
          </div>
          <div class="rounded-xl bg-ink-50 border border-ink-100 p-5 sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wider text-ink-600">
              Open source
            </dt>
            <dd class="mt-2 text-ink-900 font-medium">
              <a
                href="https://github.com/vinelabs-de"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-vine-900"
              >
                github.com/vinelabs-de
              </a>
            </dd>
            <dd class="mt-1 text-xs text-ink-400">Issues, PRs, discussions, releases</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
