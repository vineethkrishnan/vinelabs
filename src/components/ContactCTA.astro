---
---

<section id="contact" class="py-20 md:py-28 scroll-mt-24">
  <div class="container-page">
    <div class="relative rounded-3xl overflow-hidden border border-vine-100 bg-white shadow-card">
      <div
        class="absolute -top-24 -right-12 h-72 w-72 rounded-full bg-leaf-500/20 blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-24 -left-12 h-72 w-72 rounded-full bg-vine-700/15 blur-3xl pointer-events-none"
      >
      </div>

      <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 p-8 md:p-14">
        <div>
          <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-balance">
            Have a project, a question, or a bug to file?
          </h2>
          <p class="mt-4 text-ink-600 text-lg leading-relaxed text-pretty">
            We answer every email from a real person. For sales and partnerships use info, for product issues use support.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="mailto:info@vinelabs.de" class="btn btn-primary">
              info@vinelabs.de
            </a>
            <a href="mailto:support@vinelabs.de" class="btn btn-ghost-light">
              support@vinelabs.de
            </a>
          </div>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-5 self-center">
          <div class="rounded-xl bg-vine-50/60 border border-vine-100 p-5">
            <dt class="text-xs font-semibold uppercase tracking-wider text-vine-700">
              Sales + general
            </dt>
            <dd class="mt-2 text-ink-900 font-medium">info@vinelabs.de</dd>
            <dd class="mt-1 text-xs text-ink-400">Reply within 1 business day</dd>
          </div>
          <div class="rounded-xl bg-vine-50/60 border border-vine-100 p-5">
            <dt class="text-xs font-semibold uppercase tracking-wider text-vine-700">
              Product support
            </dt>
            <dd class="mt-2 text-ink-900 font-medium">support@vinelabs.de</dd>
            <dd class="mt-1 text-xs text-ink-400">See <a href="/support" class="underline">support policy</a></dd>
          </div>
          <div class="rounded-xl bg-ink-50 border border-ink-100 p-5 sm:col-span-2">
            <dt class="text-xs font-semibold uppercase tracking-wider text-ink-600">
              Open source
            </dt>
            <dd class="mt-2 text-ink-900 font-medium">
              <a
                href="https://github.com/vinelabs-de"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-vine-900"
              >
                github.com/vinelabs-de
              </a>
            </dd>
            <dd class="mt-1 text-xs text-ink-400">Issues, PRs, discussions</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
