---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import CategoriesStrip from "~/components/CategoriesStrip.astro";
import StatStrip from "~/components/StatStrip.astro";
import ProjectsGrid from "~/components/ProjectsGrid.astro";
import DarkBand from "~/components/DarkBand.astro";
import ContactCTA from "~/components/ContactCTA.astro";
import { getCollection } from "astro:content";

const description =
  "A personal open-source lab: CLI tools, web apps, browser extensions, AI agents, and design systems. Self-host friendly, open by default.";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const projectsStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "VineLab open-source projects",
  itemListElement: projects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "SoftwareSourceCode",
      name: project.data.name,
      description: project.data.description,
      codeRepository: project.data.repo,
      programmingLanguage: project.data.language,
      license: project.data.license,
      ...(project.data.docs ? { url: project.data.docs } : {}),
    },
  })),
};
---

<BaseLayout title="VineLab - A small lab. Many things shipped." description={description}>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(projectsStructuredData)}
  />
  <Hero />
  <CategoriesStrip />
  <ProjectsGrid />
  <StatStrip />
  <DarkBand />
  <ContactCTA />
</BaseLayout>
